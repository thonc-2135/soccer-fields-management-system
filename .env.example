NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=soccer_fields

# access token lifetime in seconds (15 min); refresh token lifetime in days
JWT_SECRET=change-me
JWT_EXPIRES_IN=900

REDIS_HOST=localhost
REDIS_PORT=6379
REFRESH_TOKEN_TTL_DAYS=7

# base URL used to build links in emails (the activation link hits this API)
APP_URL=http://localhost:3000
ACTIVATION_TOKEN_TTL_HOURS=24

# SMTP (Mailpit in dev: UI at http://localhost:8025). MAIL_USER/MAIL_PASSWORD/MAIL_SECURE for real SMTP.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Soccer Fields <no-reply@soccer-fields.local>"

# `pnpm seed`
SEED_ADMIN_EMAIL=admin@soccer.local
SEED_ADMIN_PASSWORD=Admin@123
